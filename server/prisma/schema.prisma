generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String
  phone     String?
  plan      String   @default("trial")
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  properties  Property[]
  residents   Resident[]
  payments    Payment[]
  complaints  Complaint[]
  auditLogs   AuditLog[]

  @@map("accounts")
}

model User {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  email        String
  phone        String?
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String?   @map("last_name")
  role         String // owner, manager, warden, reception, finance, maintenance, staff, resident
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  account            Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  resident           Resident?
  staysCreated       Stay[]       @relation("StayCreator")
  paymentsCreated    Payment[]    @relation("PaymentCreator")
  complaintsAssigned Complaint[] @relation("AssignedComplaints")
  complaintsResolved Complaint[] @relation("ResolvedComplaints")

  @@unique([accountId, email])
  @@map("users")
}

model Property {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  name         String
  type         String // hostel, pg, coliving, dormitory, workforce
  address      String
  city         String
  state        String
  pincode      String?
  latitude     Float?
  longitude    Float?
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  rules        Json     @default("{}")
  amenities    Json     @default("[]")
  imageUrl     String?  @map("image_url")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  buildings  Building[]
  residents  Resident[]
  complaints Complaint[]

  @@map("properties")
}

model Building {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  name        String
  floorsCount Int?     @map("floors_count")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors   Floor[]

  @@map("buildings")
}

model Floor {
  id          String   @id @default(uuid())
  buildingId  String   @map("building_id")
  floorNumber Int      @map("floor_number")
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([buildingId, floorNumber])
  @@map("floors")
}

model Room {
  id            String   @id @default(uuid())
  floorId       String   @map("floor_id")
  roomNumber    String   @map("room_number")
  roomType      String   @map("room_type") // single, double, triple, dormitory
  sharingType   String?  @map("sharing_type")
  rentAmount    Float    @map("rent_amount")
  depositAmount Float    @default(0) @map("deposit_amount")
  amenities     Json     @default("[]")
  status        String   @default("active") // active, maintenance, inactive
  createdAt     DateTime @default(now()) @map("created_at")

  floor       Floor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  beds        Bed[]
  complaints  Complaint[]

  @@unique([floorId, roomNumber])
  @@map("rooms")
}

model Bed {
  id                  String    @id @default(uuid())
  roomId              String    @map("room_id")
  bedNumber           String    @map("bed_number")
  bedType             String    @default("standard") @map("bed_type")
  status              String    @default("available") // available, occupied, reserved, maintenance, blocked
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")

  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  currentResident Resident? @relation("BedResident")
  stays           Stay[]

  @@unique([roomId, bedNumber])
  @@map("beds")
}

model Resident {
  id                String   @id @default(uuid())
  accountId         String   @map("account_id")
  propertyId        String   @map("property_id")
  bedId             String?  @unique @map("bed_id")
  userId            String?  @unique @map("user_id")
  firstName         String   @map("first_name")
  lastName          String?  @map("last_name")
  email             String?
  phone             String
  dateOfBirth       String?  @map("date_of_birth")
  gender            String?
  idType            String?  @map("id_type")
  idNumber          String?  @map("id_number")
  idDocumentUrl     String?  @map("id_document_url")
  photoUrl          String?  @map("photo_url")
  emergencyName     String?  @map("emergency_name")
  emergencyPhone    String?  @map("emergency_phone")
  emergencyRelation String?  @map("emergency_relation")
  occupation        String?
  institution       String?
  status            String   @default("active") // active, notice_given, checked_out, blacklisted
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property   Property      @relation(fields: [propertyId], references: [id])
  bed        Bed?          @relation("BedResident", fields: [bedId], references: [id])
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  stays      Stay[]
  payments   Payment[]
  complaints Complaint[]

  @@map("residents")
}

model Stay {
  id               String   @id @default(uuid())
  residentId       String   @map("resident_id")
  bedId            String   @map("bed_id")
  checkInDate      String   @map("check_in_date")
  expectedCheckOut String?  @map("expected_check_out")
  actualCheckOut   String?  @map("actual_check_out")
  rentAmount       Float    @map("rent_amount")
  depositAmount    Float    @default(0) @map("deposit_amount")
  depositStatus    String   @default("held") @map("deposit_status")
  status           String   @default("active") // active, notice_given, checked_out, transferred
  noticeDate       String?  @map("notice_date")
  noticePeriodDays Int      @default(30) @map("notice_period_days")
  createdById      String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  bed       Bed      @relation(fields: [bedId], references: [id])
  createdBy User?    @relation("StayCreator", fields: [createdById], references: [id])
  payments  Payment[]

  @@map("stays")
}

model Payment {
  id            String   @id @default(uuid())
  accountId     String   @map("account_id")
  residentId    String   @map("resident_id")
  stayId        String?  @map("stay_id")
  type          String // rent, deposit, maintenance, mess, other
  amount        Float
  dueDate       String   @map("due_date")
  paidDate      String?  @map("paid_date")
  status        String   @default("pending") // pending, paid, partial, overdue, waived
  paidAmount    Float    @default(0) @map("paid_amount")
  paymentMethod String?  @map("payment_method")
  transactionId String?  @map("transaction_id")
  rentMonth     Int?     @map("rent_month")
  rentYear      Int?     @map("rent_year")
  notes         String?
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  resident  Resident @relation(fields: [residentId], references: [id])
  stay      Stay?    @relation(fields: [stayId], references: [id])
  createdBy User?    @relation("PaymentCreator", fields: [createdById], references: [id])

  @@map("payments")
}

model Complaint {
  id               String    @id @default(uuid())
  accountId        String    @map("account_id")
  propertyId       String    @map("property_id")
  residentId       String?   @map("resident_id")
  category         String
  subCategory      String?   @map("sub_category")
  title            String
  description      String?
  priority         String    @default("medium")
  roomId           String?   @map("room_id")
  bedId            String?   @map("bed_id")
  assignedToId     String?   @map("assigned_to")
  status           String    @default("open")
  resolutionNotes  String?   @map("resolution_notes")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedById     String?   @map("resolved_by")
  slaHours         Int       @default(48) @map("sla_hours")
  slaDeadline      DateTime? @map("sla_deadline")
  slaBreached      Boolean   @default(false) @map("sla_breached")
  residentRating   Int?      @map("resident_rating")
  residentFeedback String?   @map("resident_feedback")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id])
  resident   Resident?  @relation(fields: [residentId], references: [id])
  room       Room?      @relation(fields: [roomId], references: [id])
  assignedTo User?      @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  resolvedBy User?      @relation("ResolvedComplaints", fields: [resolvedById], references: [id])

  @@map("complaints")
}

model AuditLog {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
